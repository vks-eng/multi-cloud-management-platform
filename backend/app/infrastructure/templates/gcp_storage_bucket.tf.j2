# Generated by Multi-Cloud Management Platform - template: gcp_storage_bucket
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = {{ account_external_id | hcl }}
}

resource "google_storage_bucket" "{{ name | tf_id }}" {
  name                        = {{ name | hcl }}
  location                    = {{ region | upper | hcl }}
  storage_class               = {{ storage_class | hcl }}
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"

  versioning {
    enabled = {{ versioning | hcl }}
  }

  labels = {{ tags | hcl_map }}
}
