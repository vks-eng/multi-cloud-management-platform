# Generated by Multi-Cloud Management Platform - template: azure_storage_account
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = {{ account_external_id | hcl }}
}

resource "azurerm_storage_account" "{{ name | tf_id }}" {
  name                            = {{ name | hcl }}
  location                        = {{ region | hcl }}
  resource_group_name             = {{ resource_group | hcl }}
  account_tier                    = "Standard"
  account_kind                    = "StorageV2"
  account_replication_type        = {{ replication | hcl }}
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false
  https_traffic_only_enabled      = true

  tags = {{ tags | hcl_map }}
}
