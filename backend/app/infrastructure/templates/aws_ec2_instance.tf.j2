# Generated by Multi-Cloud Management Platform - template: aws_ec2_instance
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region              = {{ region | hcl }}
  allowed_account_ids = [{{ account_external_id | hcl }}]
}

resource "aws_instance" "{{ name | tf_id }}" {
  ami           = {{ ami_id | hcl }}
  instance_type = {{ instance_size | hcl }}

  metadata_options {
    http_tokens   = "required"
    http_endpoint = "enabled"
  }

  root_block_device {
    volume_size = {{ root_volume_gb | hcl }}
    volume_type = "gp3"
    encrypted   = true
  }

  tags = {{ tags | hcl_map }}

  lifecycle {
    prevent_destroy = false
  }
}

output "instance_id" {
  value = aws_instance.{{ name | tf_id }}.id
}
