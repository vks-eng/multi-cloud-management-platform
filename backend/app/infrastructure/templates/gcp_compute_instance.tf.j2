# Generated by Multi-Cloud Management Platform - template: gcp_compute_instance
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = {{ account_external_id | hcl }}
  region  = {{ region | hcl }}
}

resource "google_compute_instance" "{{ name | tf_id }}" {
  name         = {{ name | hcl }}
  machine_type = {{ instance_size | hcl }}
  zone         = {{ (region ~ "-a") | hcl }}

  boot_disk {
    initialize_params {
      image = {{ image | hcl }}
    }
  }

  network_interface {
    network = "default"
    # No access_config block: the instance gets no external IP.
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  labels = {{ tags | hcl_map }}
}
