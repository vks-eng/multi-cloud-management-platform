# Generated by Multi-Cloud Management Platform - template: azure_vm
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  subscription_id = {{ account_external_id | hcl }}
}

variable "admin_ssh_public_key" {
  type        = string
  description = "SSH public key for the admin user (supplied at apply time, never stored)."
}

resource "azurerm_network_interface" "{{ name | tf_id }}" {
  name                = {{ (name ~ "-nic") | hcl }}
  location            = {{ region | hcl }}
  resource_group_name = {{ resource_group | hcl }}

  ip_configuration {
    name                          = "internal"
    subnet_id                     = {{ subnet_id | hcl }}
    private_ip_address_allocation = "Dynamic"
  }

  tags = {{ tags | hcl_map }}
}

resource "azurerm_linux_virtual_machine" "{{ name | tf_id }}" {
  name                            = {{ name | hcl }}
  location                        = {{ region | hcl }}
  resource_group_name             = {{ resource_group | hcl }}
  size                            = {{ instance_size | hcl }}
  admin_username                  = {{ admin_username | hcl }}
  disable_password_authentication = true
  network_interface_ids           = [azurerm_network_interface.{{ name | tf_id }}.id]

  admin_ssh_key {
    username   = {{ admin_username | hcl }}
    public_key = var.admin_ssh_public_key
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "ubuntu-24_04-lts"
    sku       = "server"
    version   = "latest"
  }

  tags = {{ tags | hcl_map }}
}
