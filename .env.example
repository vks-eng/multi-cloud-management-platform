# CloudOrbit configuration. Copy to .env and adjust. NEVER commit a real .env file.

# --- general -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database (PostgreSQL only) ----------------------------------------------------------
# docker-compose builds DATABASE_URL for the containers from these three values:
POSTGRES_USER=mcmp
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mcmp
# Used when running the backend directly on your machine:
DATABASE_URL=postgresql+psycopg://mcmp:change-me-postgres-password@localhost:5432/mcmp

# --- auth --------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_SELF_REGISTRATION=true

# --- credential encryption (Fernet keys, comma-separated; the first key encrypts) -----------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = a key derived from JWT_SECRET_KEY (development only; production refuses to start).
CREDENTIALS_ENCRYPTION_KEYS=

# --- cloud adapters: mock | real (real needs: pip install -r backend/requirements-cloud.txt) --
CLOUD_PROVIDER_MODE=mock

# --- background jobs -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# true = run tasks in-process (no Redis needed). docker-compose overrides this to false.
CELERY_TASK_ALWAYS_EAGER=true
SYNC_INTERVAL_MINUTES=60

# --- terraform -----------------------------------------------------------------------------
TERRAFORM_BINARY=terraform
TERRAFORM_WORKDIR=.terraform-runs
# auto = run terraform when the binary exists AND CLOUD_PROVIDER_MODE=real; mock = always mock
TERRAFORM_MODE=auto
# Real `terraform apply` stays disabled unless true (explicit confirmation is still required).
TERRAFORM_APPLY_ENABLED=false
PROVISIONING_CONFIRMATION_TTL_MINUTES=30

# --- frontend (build time) -------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
